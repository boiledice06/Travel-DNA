# LLM provider (swappable). Default: vertex
TRAVEL_MVP_LLM_PROVIDER=vertex

# Optional: separate frontend origins (comma-separated). Empty = no CORS middleware.
# Example: CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:5173
CORS_ALLOW_ORIGINS=

# Vertex / gcloud ADC (same pattern as Desktop Aider)
VERTEXAI_PROJECT=bright-anagram-505514-h2
VERTEXAI_LOCATION=global
VERTEXAI_MODEL=gemini-3.8-flash
# Aliases also accepted:
# GOOGLE_CLOUD_PROJECT=bright-anagram-505514-h2
# GOOGLE_CLOUD_LOCATION=global

# Auth: do NOT put API keys here for Vertex.
# Use Application Default Credentials:
#   gcloud auth application-default login
# ADC file typically:
#   %APPDATA%\gcloud\application_default_credentials.json

# --- Stage 4: Google Places API (New) Text Search (NOT Vertex) ---
# Required for Seoul place finding (POST /api/seoul-find) and /api/places-search.
# Enable "Places API (New)" on the GCP project. Legacy Place Text Search often returns REQUEST_DENIED.
# Do not invent keys — paste a real key from Google Cloud Console. Never commit real keys.
GOOGLE_PLACES_API_KEY=
# GOOGLE_MAPS_API_KEY=   # accepted as alias

# --- Optional: Korea TourAPI (data.go.kr KorService2) — Seoul areaCode=1 ---
# If unset, Seoul find uses Places only (graceful skip).
TOUR_API_KEY=
# DATA_GO_KR_SERVICE_KEY=  # alias

# --- Optional: Visit Seoul (stub / deferred adapter) ---
# VISITSEOUL_API_KEY=
